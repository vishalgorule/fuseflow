<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.fuseflow</groupId>
        <artifactId>fuseflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fuseflow-sdk</artifactId>
    <name>FuseFlow Worker SDK</name>
    <description>Java Worker SDK — @Activity + @Workflow annotations + runtime (Phase 4/6)</description>

    <dependencies>
        <!-- Shared wire contract: activity task/result messages, registry DTOs, correlation ID. -->
        <dependency>
            <groupId>io.fuseflow</groupId>
            <artifactId>fuseflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- JSON (Jackson 3 ObjectMapper) for the Kafka payloads and activity outputs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- RestClient for registry registration/heartbeats. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Kafka producer + listener container for dispatch/results. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The SDK module itself defines no @Workflow classes, and its tests
                         deliberately exercise invalid annotation scenarios at runtime, so
                         compile-time processing is off here (it is ON for SDK consumers via
                         the parent default). -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
